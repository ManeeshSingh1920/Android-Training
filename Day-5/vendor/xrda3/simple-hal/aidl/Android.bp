aidl_interface {
    name: "vendor.xrda3.simple_hal_interface",

    // demo = no VINTF/stable
    unstable: true,

    // You can leave this if you want to use it from vendor code as well
    vendor_available: true,

    srcs: [
        "vendor/example/simple/ISimple.aidl",
    ],

    backend: {
        ndk:  { enabled: true },
        java: { enabled: true },
        cpp:  { enabled: false },
    },
}

